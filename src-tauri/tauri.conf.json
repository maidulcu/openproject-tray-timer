{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DWL timer",
  "version": "0.4.6",
  "identifier": "com.dynamicweblab.dwl-timer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DWL timer",
        "width": 440,
        "height": 600,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Tray timer for OpenProject with idle detection",
    "longDescription": "Start and stop OpenProject's own timer from the tray, stopping by itself when you're away and asking what that time was.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5QjUxNTg4N0IxMzdCOTcKUldTWGV4TjdpQlcxU2RrQmhMUU0rTDZreFJrVld2MXN0MEFOYm9acVIrWnRTcVZRQ2FIR2FvQ2gK",
      "endpoints": [
        "https://projects.dynamicweblab.com/timer/latest.json"
      ]
    }
  }
}
